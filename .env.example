# Tradeflow Environment Variables
# Copy this file to .env in the root directory

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# DB_PATH=tradeflow.db

# ---------------------------------------------------------------------------
# Frontend Configuration
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# API Keys and Data Sources
# ---------------------------------------------------------------------------
# Note: Market Data URLs (like NSE) are NOT configured via .env anymore.
# They must be configured directly within the Tradeflow Settings UI.
# Please refer to DATA_SOURCES.md for valid data source URLs.

# LLM keys (Groq) can also be configured in the UI, but if you prefer to
# inject them via environment for Docker setups, you can do so here:
# GROQ_API_KEY=gsk_...
