# Tradeflow Environment Variables

# ==========================================
# REQUIRED VARIABLES
# ==========================================

# App authentication — set a long random string (e.g., openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string-for-production

# ==========================================
# DOCKER OVERRIDES (Optional)
# ==========================================

# If running in Docker but you want to point to a custom Ollama host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Note: GROQ_API_KEY and other LLM settings are now configured via the UI 
# and stored in settings.json, so they are not needed here!
